<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions — each one justified per the spec's NFR table (§4) and
        §12.2 (reconstruction after reboot). See root README "Permissions"
        section for the same list with rationale in prose.
    -->

    <!-- Schedule the exact end-of-cooking and per-step reminder alarms (EF-16/EF-19/EF-22). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Briefly wake the CPU to reliably fire/display the end-of-cooking alarm (EF-23). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Show the persistent cooking notification and the full-screen alarm notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibrate on step reminders (EF-19) and on the end alarm (EF-23). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        NOT in the spec's original NFR permission list (§4) — added because
        §12.2 requires reconstructing a running cooking session (and its
        alarms) after a phone reboot from the persisted absolute end
        timestamp. Needed for BootReceiver to receive BOOT_COMPLETED.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+ requires declaring the alarm-manager foreground service type explicitly. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Show the full-screen alarm activity over the lock screen (EF-23). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".CuissonVapeurApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CuissonVapeur">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CuissonVapeur">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- EF-23: full-screen alarm shown even when the app is closed / phone locked. -->
        <activity
            android:name=".ui.screens.alarme.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.CuissonVapeur.Alarm" />

        <!-- Fires the end-of-cooking alarm and per-step reminder alarms (EF-16/EF-19/EF-23). -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- §12.2: re-arms all pending alarms from the persisted absolute end timestamp. -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Handles notification actions: "Prolonger +2 min", "OK, c'est prêt", pause/resume. -->
        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:exported="false" />

        <!-- Minimal Android 12+ foreground service showing the persistent cooking notification. -->
        <service
            android:name=".alarm.CookingTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Minuteur de cuisson vapeur en cours (voir écran Timer actif)" />
        </service>

    </application>

</manifest>
