<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup/transfer rules. EF-30: no data leaves the
    phone in any networked sense, but Android's own device-to-device
    transfer and cloud backup are OS features outside that scope — allowing
    them here just restores the user's own local favorites/cart/settings
    on a new device, which is a convenience, not a data collection path.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
